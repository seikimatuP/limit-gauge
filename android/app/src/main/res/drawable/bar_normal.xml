<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_bar_radius" />
            <solid android:color="@color/lg_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleGravity="left|center_vertical" android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/widget_bar_radius" />
                <solid android:color="@color/lg_accent" />
            </shape>
        </scale>
    </item>
</layer-list>
