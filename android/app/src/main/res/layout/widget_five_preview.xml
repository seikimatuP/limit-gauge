<?xml version="1.0" encoding="utf-8"?>
<!-- Static sample for the widget picker. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ProgressBar
                android:id="@+id/g_ring"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="400dp"
                android:maxWidth="400dp"
                android:minHeight="10dp"
                android:minWidth="10dp"
                android:progress="77"
                android:progressBackgroundTint="@color/lg_track"
                android:progressDrawable="@drawable/ring_normal"
                android:progressTint="@color/lg_accent" />

            <ProgressBar
                android:id="@+id/g_ring_low"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="400dp"
                android:maxWidth="400dp"
                android:minHeight="10dp"
                android:minWidth="10dp"
                android:progress="77"
                android:progressBackgroundTint="@color/lg_track"
                android:progressDrawable="@drawable/ring_low"
                android:progressTint="@color/lg_critical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/g_value"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:maxLines="1"
                android:text="77%"
                android:textColor="@color/lg_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/g_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/gauge_five_left"
            android:textColor="@color/lg_text_secondary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/g_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/lg_text_secondary"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
