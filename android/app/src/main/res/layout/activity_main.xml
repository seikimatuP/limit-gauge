<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_gauge" />

            <TextView
                style="@style/LgTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name" />
        </LinearLayout>

        <TextView
            style="@style/LgSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/main_subtitle" />

        <!-- 5 hours -->
        <LinearLayout
            style="@style/LgCard"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    style="@style/LgCardLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_five_hour" />

                <TextView
                    android:id="@+id/five_value"
                    style="@style/LgCardValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/value_none" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/five_bar"
                style="@style/LgBar" />

            <TextView
                android:id="@+id/five_detail"
                style="@style/LgSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Weekly -->
        <LinearLayout
            style="@style/LgCard"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    style="@style/LgCardLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_weekly" />

                <TextView
                    android:id="@+id/week_value"
                    style="@style/LgCardValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/value_none" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/week_bar"
                style="@style/LgBar" />

            <TextView
                android:id="@+id/week_detail"
                style="@style/LgSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_line"
            style="@style/LgSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/error_line"
            style="@style/LgError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/refresh_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/refresh_now" />

        <!-- Widgets -->
        <TextView
            style="@style/LgSection"
            android:text="@string/section_widgets" />

        <LinearLayout style="@style/LgButtonRow">

            <Button
                android:id="@+id/add_card"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_card_widget" />

            <Button
                android:id="@+id/add_week"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_week_widget" />

            <Button
                android:id="@+id/add_five"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_five_widget" />
        </LinearLayout>

        <TextView
            style="@style/LgSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widgets_hint" />

        <!-- Connection -->
        <TextView
            style="@style/LgSection"
            android:text="@string/section_connection" />

        <EditText
            android:id="@+id/url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_url"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1" />

        <EditText
            android:id="@+id/token_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:hint="@string/hint_token"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1" />

        <CheckBox
            android:id="@+id/show_token"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_token" />

        <LinearLayout style="@style/LgButtonRow">

            <Button
                android:id="@+id/save_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save_and_test" />

            <Button
                android:id="@+id/paste_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/paste_link" />
        </LinearLayout>

        <!-- Display -->
        <TextView
            style="@style/LgSection"
            android:text="@string/section_display" />

        <RadioGroup
            android:id="@+id/mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/mode_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_left" />

            <RadioButton
                android:id="@+id/mode_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/mode_used" />
        </RadioGroup>

        <Switch
            android:id="@+id/notify_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/notify_switch" />

        <Switch
            android:id="@+id/live_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/live_switch" />

        <TextView
            android:id="@+id/live_hint"
            style="@style/LgSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/live_hint" />

        <!-- How it works -->
        <TextView
            style="@style/LgSection"
            android:text="@string/section_setup" />

        <TextView
            style="@style/LgSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_body" />

        <TextView
            style="@style/LgSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/unofficial_note"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/version_text"
            style="@style/LgSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
