<?xml version="1.0" encoding="utf-8"?>
<!-- Notification, collapsed (DecoratedCustomViewStyle content, at most about 48dp tall):
     weekly ring + label + value on the left, the weekly countdown and a small 5-hour ring on the right.
     Filled by Notifier. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="@dimen/ring_notif"
        android:layout_height="@dimen/ring_notif">

        <ImageView
            android:id="@+id/w_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/gauge_empty"
            android:tint="@color/lg_gauge"
            android:tintMode="src_in" />

        <ImageView
            android:id="@+id/w_ring_low"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:tint="@color/lg_critical"
            android:tintMode="src_in"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/lg_gauge_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/value_none"
            android:textColor="@color/lg_gauge_text"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/lg_gauge_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/ring_xs"
                android:layout_height="@dimen/ring_xs">

                <ImageView
                    android:id="@+id/f_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:tint="@color/lg_gauge"
                    android:tintMode="src_in" />

                <ImageView
                    android:id="@+id/f_ring_low"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:tint="@color/lg_critical"
                    android:tintMode="src_in"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/f_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/lg_gauge_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
